<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ runtime permission. The pre-permission explainer lands in Sprint A8;
         the permission is declared now because the A1.6 FCM slice needs it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- D.7's upload worker runs `setForeground()` with a progress notification so the
         OS does not kill a large upload mid-PUT — Android 14+ requires the matching
         foreground-service-type permission declared explicitly, on top of the general one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".NyayaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NyayaAI.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NyayaAI.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- B.8 deep link scheme. Every push routes through here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nyayaai" />
            </intent-filter>
        </activity>

        <!-- B.8. Data-only messages, so this runs foreground, background and cold.
             Harmless when google-services.json is absent: FirebaseApp never initialises,
             so nothing is ever delivered here. -->
        <service
            android:name=".push.NyayaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Ships the scanner module with the install rather than downloading it on
             first use, so a lawyer in a courthouse basement with no signal can still
             scan an order sheet. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="docscanner" />

        <!-- WorkManager's default `androidx.startup` initializer would build the
             singleton with the stock `WorkerFactory`, which cannot construct
             `ScanUploadWorker` (it needs Hilt-injected dependencies). Removing it here
             is what makes `NyayaApplication.workManagerConfiguration` — the one that
             supplies the `HiltWorkerFactory` — the configuration WorkManager actually
             uses; on-demand initialization then builds WorkManager lazily from that. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup.InitializationProvider"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
