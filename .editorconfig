root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
# Must match detekt's MaxLineLength in config/detekt/detekt.yml. If these two disagree,
# ktlintFormat collapses expressions onto lines that detekt then rejects, and CI can never
# be green and formatted at the same time.
max_line_length = 120
ktlint_standard_function-naming = disabled
ktlint_standard_backing-property-naming = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
