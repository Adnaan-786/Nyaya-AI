# =========================
# Application
# =========================
APP_NAME=NyayaAI Server
APP_ENV=development
DEBUG=true
API_VERSION=v1
API_PREFIX=/v1

# =========================
# Security
# =========================
SECRET_KEY=chanSECRET_KEY=change_this_to_a_long_random_secret_key_at_least_32_charsge_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# Database
# =========================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nyayaai

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379/0

# =========================
# Storage
# =========================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nyayaai

# =========================
# External Services
# =========================
FAKE_MODE=true

OCR_PROVIDER=tesseract
LLM_PROVIDER=openai

# =========================
# Monitoring
# =========================
SENTRY_DSN=
LOG_LEVEL=INFO