APP_NAME=NyayaAI Server
ENVIRONMENT=development
DEBUG=true

API_PREFIX=/v1

LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/nyayaai
# DATABASE_URL=postgresql+asyncpg://nyayaai_app:nyayaai123@localhost:5432/nyayaai
SECRET_KEY=replace_with_a_long_random_secret_key_at_least_32_characters

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nyayaai

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nyayaai

FAKE_MODE=true