APP_NAME=NyayaAI Server
ENVIRONMENT=development
DEBUG=true

API_PREFIX=/v1

LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/nyayaai
# DATABASE_URL=postgresql+asyncpg://nyayaai_app:nyayaai123@localhost:5432/nyayaai
SECRET_KEY=change_this_to_a_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nyayaai

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nyayaai

FAKE_MODE=true
OCR_PROVIDER=tesseract
LLM_PROVIDER=openai

OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_PER_HOUR=3
OTP_MAX_VERIFY_ATTEMPTS=5

# =========================
# Document Pipeline (module M6)
# =========================
DOCUMENT_MAX_UPLOAD_BYTES=52428800
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document
DOCUMENT_UPLOAD_URL_EXPIRY_SECONDS=900
DOCUMENT_DOWNLOAD_URL_EXPIRY_SECONDS=900
DOCUMENT_CHUNK_WORDS=600
DOCUMENT_CHUNK_OVERLAP_WORDS=80

# =========================
# Embeddings
# =========================
EMBEDDING_PROVIDER=fake
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=

# =========================
# AI Services (module M7)
# =========================
# fake (default, deterministic offline heuristics) | anthropic
LLM_PROVIDER=fake
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
ANTHROPIC_API_KEY=

AI_MAX_CONCURRENT_JOBS_PER_TENANT=3
AI_DAILY_JOB_QUOTA_PER_TENANT=50
AI_SUMMARIZE_TIMEOUT_SECONDS=300
AI_RESEARCH_TIMEOUT_SECONDS=120
AI_DRAFT_TIMEOUT_SECONDS=180
AI_RISK_REVIEW_TIMEOUT_SECONDS=180

# =========================
# Researcher (module M7)
# =========================
# fixture (default, offline synthetic case-law corpus) | indiankanoon
INDIAN_KANOON_PROVIDER=fixture
INDIAN_KANOON_API_KEY=
RESEARCH_RETRIEVE_TOP_K=20
RESEARCH_RERANK_TOP_K=6
RESEARCH_MIN_VERIFIED_CITATIONS=2

# =========================
# Notifications (module M9)
# =========================
MSG91_AUTH_KEY=

migration_database_url=

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

GUPSHUP_API_KEY=
GUPSHUP_SOURCE_NUMBER=

NOTIFICATION_DEFAULT_DIGEST_TIME=19:00
NOTIFICATION_MORNING_REMINDER_TIME=07:30
NOTIFICATION_OUTCOME_NUDGE_TIME=20:00
NOTIFICATION_DIGEST_SCAN_INTERVAL_MINUTES=15

# =========================
# Billing and Payments (module M10)
# =========================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

INVOICE_DEFAULT_GST_RATE=18
INVOICE_OVERDUE_REMINDER_MAX_COUNT=3
INVOICE_OVERDUE_REMINDER_SPACING_DAYS=5

APP_MIN_SUPPORTED_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_SUPPORT_EMAIL=support@nyayaai.in
APP_SUPPORT_PHONE=
# Shared secret for PATCH /v1/app/config. Empty = updates always rejected.
ADMIN_API_KEY=